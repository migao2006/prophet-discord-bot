# Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=replace_with_bot_token
# General Information > Application ID
DISCORD_APPLICATION_ID=replace_with_application_id
# Discord Developer Mode > right-click your test server > Copy Server ID
DISCORD_GUILD_ID=replace_with_server_id
# Northflank PostgreSQL addon 的連線字串
DATABASE_URL=postgresql://user:password@host:5432/database
# Northflank 正式環境請設為 true；本機未啟用 TLS 的 PostgreSQL 可設 false
DATABASE_SSL=false
